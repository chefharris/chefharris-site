---
// /app stays reachable (future store-listing link) and sends visitors to the Home page.
// Static redirect: meta refresh plus canonical to "/", so search engines credit the Home page.
import { href } from '../lib/url';
const home = href('/');
const canonical = new URL(home, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chef Harris</title>
    <meta http-equiv="refresh" content={`0; url=${home}`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p><a href={home}>Chef Harris</a></p>
  </body>
</html>

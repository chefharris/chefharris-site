---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import heroSrc from '../assets/brand/hero_pan_toss_2048.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href } from '../lib/url';
import { SITE } from '../site.config';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
}
const { title, description, ogType = 'website', publishedTime } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: heroSrc, width: 1200, height: 1200, format: 'jpeg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);
const fontUrl = href('/fonts/texgyreschola-bold.woff2');
const fontFace = `@font-face{font-family:'Schola';src:url('${fontUrl}') format('woff2');font-weight:700;font-style:normal;font-display:swap;}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!__IS_PRODUCTION__ && <meta name="robots" content="noindex" />}
    {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={href('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={href('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFace}></style>
    {SITE.goatcounterCode && (
      <script data-goatcounter={`https://${SITE.goatcounterCode}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js" is:inline></script>
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

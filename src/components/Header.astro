---
import { Image } from 'astro:assets';
import lockup from '../assets/brand/lockup_horizontal_sage_2400.png';
import { href } from '../lib/url';
---
<header class="site-header">
  <div class="inner">
    <a href={href('/')} aria-label="Chef Harris – home">
      <Image src={lockup} alt="Chef Harris" width={1020} widths={[340, 680, 1020]} sizes="(min-width: 600px) 325px, 274px" format="png" loading="eager" />
    </a>
  </div>
</header>
